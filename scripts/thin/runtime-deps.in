# What the served code needs on top of ttnn + torch. Source of truth for the
# tt-openvla-runtime-deps wheel (scripts/package-thin.sh builds it) and for constraints.txt.
# Found by reading the imports of scripts/thin/served_files.txt and of the tt-metal closure
# in ttt_closure.txt, plus what ttnn 0.77.0 and gradio 5.40.0 declare.
#
# Pins mirror the versions the 0.2.1 bundle was verified with on hardware.
transformers==4.52.4      # AutoProcessor, and the LLaMA config/tokenizer
tokenizers==0.21.4
timm==1.0.29              # the openvla processor's remote code imports timm and torchvision
safetensors               # openvla_weights.py, load_checkpoints.py
huggingface_hub<1.0       # snapshot_download; gradio 5.x and tokenizers 0.21 need <1.0
gradio==5.40.0            # 6.x needs huggingface_hub>=1.16
json-numpy                # /act request and response bodies
fastapi
uvicorn
pydantic>=2
pillow<12                 # gradio 5.40 caps pillow below 12
pytest                    # models/common/utility_functions.py imports it at module level
tqdm                      # models/tt_transformers/tt/model.py, load_checkpoints.py
typing_extensions         # models/common/utility_functions.py
pandas<3                  # gradio_app/app.py BarPlot value; gradio 5.40 caps it below 3
requests                  # huggingface_hub
